{
  "openapi": "3.0.3",
  "info": {
    "title": "LawGit API",
    "version": "0.2.0",
    "description": "Local HTTP API of `lawgit serve`. Every response is {\"ok\":true,\"result\":...} or {\"ok\":false,\"error\":\"...\"}. Writes require Content-Type: application/json. Authenticate with `Authorization: Bearer TOKEN` or `X-Lawgit-Token: TOKEN` when the server was started with --token."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787/api/v1"
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "summary": "Server info",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "result": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
