  "components": {
    "responses": {
      "Error": {
        "description": "Error (400 invalid, 401 token, 403 host, 404 not found, 409 conflict, 415 content type, 500 internal)",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "NewLaw": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "example": "法律"
          },
          "law_number": {
            "type": "string"
          },
          "e_gov_id": {
            "type": "string"
          },
          "commit_message": {
            "type": "string"
          }
        }
      },
      "Law": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "lowercase UUID v4"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "law_number": {
            "type": "string",
            "nullable": true
          },
          "e_gov_id": {
            "type": "string",
            "nullable": true
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "commit": {
            "$ref": "#/components/schemas/CommitInfo"
          }
        }
      },
      "NewRule": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "default": "general"
          },
          "body": {
            "type": "string",
            "description": "Markdown"
          },
          "commit_message": {
            "type": "string"
          }
        }
      },
      "UpdateRule": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "if_version": {
            "type": "string"
          },
          "commit_message": {
            "type": "string"
          }
        }
      },
      "Rule": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "lowercase UUID v4"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "created": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "changes whenever the file changes; send as if_version"
          },
          "body": {
            "type": "string"
          },
          "commit": {
            "$ref": "#/components/schemas/CommitInfo"
          }
        }
      },
      "CommitInfo": {
        "type": "object",
        "nullable": true,
        "description": "null when auto-commit is off or nothing changed; {error} when the commit failed",
        "properties": {
          "hash": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "token": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lawgit-Token"
      }
    }
  }
}